flowchart TD
    %% Inputs
    KR[/"keywords_repo.txt\n~69 keywords"/]
    KC[/"keywords_code.txt\n~78 keywords"/]

    subgraph S1["(i) Repository Search"]
        RS["repo_search.py\nGET /search/repositories\n(search rate limit: 30 req/min)"]
        CS["code_search.py\nGET /search/code\n(search rate limit: 30 req/min)"]
        RS --> |"+ GET /repos/.../pulls\n+ GET /repos/.../contributors\n(core rate limit: 5000 req/hr)"| RSO[/"repo_search_candidates.json"/]
        CS --> |"+ GET /repos/{owner}/{repo}\n+ GET /repos/.../pulls\n+ GET /repos/.../contributors\n(core rate limit: 5000 req/hr)"| CSO[/"code_search_candidates.json"/]
    end

    KR --> RS
    KC --> CS

    subgraph S2["(ii) Candidate Filtering"]
        CF["candidate_filter.py"]
        CF --> FO[/"filtered_candidates.json"/]
    end

    RSO --> CF
    CSO --> CF

    CF -.- |"merge duplicates\nfilter by PR count, stars\nmin 2 human contributors\nremove i18n/translation repos"| CF

    subgraph S3["(iii) PR Comment Collection"]
        PC["pr_collector.py\nGET /repos/.../pulls\nGET /repos/.../issues/{n}/comments\nGET /repos/.../pulls/{n}/comments\nGET /repos/.../pulls/{n}/reviews\n(core rate limit: 5000 req/hr)"]
        PC --> PCO[/"pr_comments.json"/]
    end

    FO --> PC
    PC -.- |"filter bot authors\ncache per repo for resumability"| PC

    subgraph S4["(iv) Language Filtering"]
        LF["lang_filter.py\n(lingua detector)"]
        LF --> ROC[/"ro_comments.json\n(confidence >= 0.7)"/]
        LF --> ROR[/"ro_comments_review.json\n(0.4 <= confidence < 0.7)"/]
        LF --> LS[/"lang_stats.json"/]
    end

    PCO --> LF

    subgraph S5["(v) Manual Review"]
        direction LR
        MR["Manual review of\nborderline cases"]
        MR --> MRO[/"ro_comments_verified.json"/]
    end

    ROR --> MR
    ROC --> MRO

    subgraph S6["(vi) Sentiment Analysis [TODO]"]
        SA["Sentiment analysis model\n(DEVA + prompted LLM)"]
        SA --> SAO[/"ro_comments_sentiment.json\nwith sentiment labels"/]
    end

    MRO --> SA

    subgraph S7["(vii) Analysis & Results [TODO]"]
        AN["Statistical analysis\nVisualisations\nFindings"]
    end

    SAO --> AN

